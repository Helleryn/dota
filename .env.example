# Шаблон конфигурации (Phase 4). Скопируйте в .env и заполните реальными
# значениями. .env НЕ коммитится (см. .gitignore) — здесь нет секретов,
# только структура.

# --- Границы данных (docs/architecture.md, раздел 1) ---
# Placeholder-значения ниже НЕ подтверждены живым запросом
# (docs/environment-constraints.md). Обновите после запуска
# scripts/verify_data_source.py.
DATA_START_DATE=2018-01-01
DATA_END_DATE=
MIN_MATCH_DATE=2018-01-01

# --- Time-based split (ADR-005) ---
TRAIN_START=2018-01-01
VALIDATION_START=2024-01-01
TEST_START=2025-01-01

# --- OpenDota (docs/data-sources.md) ---
# Без ключа тоже работает (60 req/min) — ключ повышает лимит до 300 req/min.
# MVP обязан работать и без OPENDOTA_API_KEY — не делайте его обязательным
# нигде в коде (Phase 5, раздел 4).
OPENDOTA_BASE_URL=https://api.opendota.com/api
OPENDOTA_API_KEY=
OPENDOTA_RATE_LIMIT_PER_MIN=55
REQUEST_TIMEOUT=20
MAX_RETRIES=4

# Совместимо с OPENDOTA_RATE_LIMIT_PER_MIN — общий алиас, если в будущем
# появится второй источник с собственным лимитом (см. src/config.py).
RATE_LIMIT=55

# Писать ли каждый сырой ответ источника в raw_responses (docs/database-design.md).
# Выключение полезно только для быстрых локальных прогонов без аудита —
# в норме должно быть включено.
RAW_DATA_ENABLED=true

# --- Liquipedia (docs/data-sources.md — обязателен контакт по ToS) ---
CONTACT_EMAIL=

# --- База данных ---
# ВНИМАНИЕ: реальный пароль НИКОГДА не коммитится — значение ниже валидно
# только для локальной БД, поднятой этой же сессией (см. docs/data-pipeline.md).
DATABASE_URL=postgresql+psycopg://dota_predict:CHANGE_ME@localhost:5432/dota_predict

# --- Backtesting (docs/backtesting.md) ---
BACKTEST_RETRAIN_INTERVAL_DAYS=90
